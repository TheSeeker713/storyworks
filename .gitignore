# Storyworks app repo — never commit user manuscripts
projects/*
!projects/.gitkeep
!projects/backup/
projects/backup/*
!projects/backup/.gitkeep
data/*
!data/.gitkeep
data/logs/*
.venv/
venv/
__pycache__/
*.py[cod]
.pytest_cache/
node_modules/
apps/web/dist/
apps/web/.vite/
*.tsbuildinfo
.DS_Store
.env
.env.local
*.sqlite
*.sqlite-*
.openclaw-token

# Bulky unconverted background dumps (converted webp + manifest are tracked)
assets/backgrounds/raw/**
!assets/backgrounds/raw/.gitkeep
