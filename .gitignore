# Storyworks app repo — never commit user manuscripts
projects/*
!projects/.gitkeep
!projects/backup/
projects/backup/*
!projects/backup/.gitkeep
data/*
!data/.gitkeep
data/logs/*
.venv/
venv/
__pycache__/
*.py[cod]
.pytest_cache/
node_modules/
apps/web/dist/
apps/web/.next/
apps/web/out/
apps/web/.vite/
*.tsbuildinfo
.DS_Store
.env
.env.local
*.sqlite
*.sqlite-*
.openclaw-token
# User vaults are never in the app repo
.vaults/
tmp/
tmp/**

# Bulky unconverted background dumps (converted webp + manifest are tracked)
assets/backgrounds/raw/**
!assets/backgrounds/raw/.gitkeep

# Local design dumps (not product law)
assets/skins/
assets/ui ux design screenshots/
