{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Storyworks",
  "version": "0.1.0",
  "identifier": "com.myceliainteractive.storyworks",
  "build": {
    "frontendDist": "../../web/out",
    "devUrl": "http://127.0.0.1:3000",
    "beforeDevCommand": "",
    "beforeBuildCommand": ""
  },
  "app": {
    "windows": [
      {
        "title": "Storyworks",
        "width": 1280,
        "height": 840,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["dmg", "app"],
    "macOS": {
      "minimumSystemVersion": "13.0",
      "signingIdentity": null,
      "providerShortName": null
    },
    "externalBin": [],
    "resources": []
  },
  "plugins": {}
}
